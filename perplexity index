            if (onclick.includes("changeLang")) basTrackLanguage(window.__basLastLang || "en");
            if (onclick.includes("resetToEnglish")) basTrackLanguage("en");
        }

        if (card) {
            const href = card.getAttribute("href") || "";
            const name = card.querySelector(".shopName")?.textContent?.trim() || "";
            basTrackOutbound("shop_card_click", href, { shop_name: name });
