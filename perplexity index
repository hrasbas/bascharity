document.addEventListener("click", function (e) {
    try {
        const a = e.target.closest("a");
        const btn = e.target.closest("button");
        const el = e.target.closest("[onclick]");

        if (a) {
            const href = a.getAttribute("href") || "";
            if (href.includes("wa.me") || href.includes("api.whatsapp.com")) {
                basTrackClick("whatsapp_share", href, { outbound: true });
            } else if (href.includes("facebook.com/sharer") || href.includes("telegram.me/share") || href.includes("twitter.com/intent")) {
                basTrackClick("social_share", href, { outbound: true });
            } else if (href.startsWith("http")) {
                basTrackClick("outbound_shop_click", href, { outbound: true });
            } else if (href.startsWith("mailto:")) {
                basTrackClick("email_click", href);
            } else if (href.startsWith("tel:")) {
                basTrackClick("phone_click", href);
            }
        }

        if (btn) {
            const text = (btn.innerText || btn.textContent || "").trim().toLowerCase();

            if (text.includes("compare prices")) {
                basTrackCTA("compare_prices");
            }

            if (text.includes("install")) {
                basTrackCTA("install_prompt");
            }

            if (text.includes("read more")) {
                basTrackCTA("read_more");
            }

            if (text.includes("less")) {
                basTrackCTA("read_less");
            }
        }

        if (el) {
            const onclick = el.getAttribute("onclick") || "";
            if (onclick.includes("copyLink")) basTrackCTA("copy_link");
            if (onclick.includes("handleInstallTap")) basTrackCTA("install_tap");
            if (onclick.includes("toggleMore7")) basTrackCTA("section7_toggle");
            if (onclick.includes("toggleWish")) basTrackCTA("wish_toggle");
            if (onclick.includes("toggleBas8")) basTrackCTA("section8_toggle");
        }
    } catch (err) {}
}, true);

