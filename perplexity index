function toggleBas8(){
    let more=document.getElementById("bas8More");
    let dots=document.getElementById("bas8Dots");
    let btn=document.getElementById("bas8Btn");
    if(opened8){
        more.style.display="none";
        dots.style.display="inline";
        btn.innerText="More Details";
