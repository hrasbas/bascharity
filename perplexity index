                basTrackOutbound("social_share", href, { link_text: text });
            } else if (href.startsWith("http")) {
                basTrackOutbound("external_link", href, { link_text: text });
            }
        }

        if (btn) {
            const text = (btn.innerText || btn.textContent || "").trim().toLowerCase();
            if (text.includes("compare prices")) basTrackCTA("compare_prices");
            if (text.includes("submit")) basTrackCTA("submit_amount");
            if (text.includes("install")) basTrackPWA("install_button_click");
        }

        if (cta) {
            const onclick = cta.getAttribute("onclick") || "";
            if (onclick.includes("copyLink")) basTrackCTA("copy_link");
