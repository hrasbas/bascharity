function loadImages() {
    photos.forEach((src, i) => {
        let card = document.createElement("div");
        card.className = "card";
        card.onclick = function() {
            scrolling = false;
            this.classList.add("zoom-active");
            basTrackGallery("zoom_open", i);
            setTimeout(() => {
                this.classList.remove("zoom-active");
                scrolling = true;
                basTrackGallery("zoom_close", i);
            }, 4000);
        };

        let img = document.createElement("img");
        if (i < 2) { img.className = "rotate"; }
        img.src = src;

        card.appendChild(img);
        gallery.appendChild(card);
    });
    basTrackGallery("images_loaded", photos.length);
}

window.addEventListener("beforeinstallprompt", (e) => {
    e.preventDefault();
    basPrompt = e;
    stat.innerText = "INSTALL";
    ball.className = "bas-ball white-b";
    basTrackPWA("install_prompt_ready");
});

window.addEventListener("appinstalled", () => {
    stat.innerText = "INSTALLED";
    ball.className = "bas-ball is-pwa-installed";
    basTrackPWA("app_installed");
});
