function submitDonationAmount() {
    let amountInput = document.getElementById('donation-amount');
    pendingAmount = amountInput.value;
    pendingTime = new Date().toISOString();

    if (!pendingAmount || pendingAmount <= 0) {
        alert("Please enter a valid amount.");
