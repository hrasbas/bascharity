}

function undoSubmission() {
    if (undoTimeout) clearTimeout(undoTimeout);
    basTrackDonation(lastClickedSite, pendingAmount, "undo");
    
    let statusDiv = document.getElementById('save-status-msg');
    statusDiv.innerHTML = `<span class="status-msg" style="color: #FF3D00;">Cancelled! You can edit now.</span>`;

