function setSelectedCountry(country) {
    if (!country) return;
    const pureCountry = country.trim().toLowerCase();

    allCountries.classList.add("green-select");

    document.querySelectorAll(".country-btn").forEach(btn => {
        const key = btn.getAttribute("data-country");
        btn.classList.toggle(
            "active",
            key && key.trim().toLowerCase() === pureCountry
        );
    });

    const shopBtn = document.getElementById("shopOnCountry");
    if (shopBtn) {
        shopBtn.innerHTML =
            `SHOP ON <span class="green">${pureCountry.toUpperCase()}</span>`;
    }

    localStorage.setItem("selectedCountry", pureCountry);

    basTrackCountry(pureCountry);
    fetchExternalCountryJS(pureCountry);
}

function renderCountry(country) {
    setSelectedCountry(country);
}

function changeLang(langCode) {
    try {
        let select = document.querySelector('select.goog-te-combo');
        if (select) {
            select.value = langCode;
            select.dispatchEvent(new Event('change'));
        }
    } catch (e) {}

    try {
        const savedCountry = localStorage.getItem("selectedCountry") || "india";
        if (typeof setSelectedCountry === "function") {
            setSelectedCountry(savedCountry);
        }
    } catch (e) {}

    basTrackLanguage(langCode);
}

function resetToEnglish() {
    try {
        let select = document.querySelector('select.goog-te-combo');
        if (select) {
            select.value = 'en';
            select.dispatchEvent(new Event('change'));
        }
    } catch (e) {}

    try {
        const savedCountry = localStorage.getItem("selectedCountry") || "india";
        if (typeof setSelectedCountry === "function") {
            setSelectedCountry(savedCountry);
        }
    } catch (e) {}

    basTrackLanguage("en");
}

function handleInstallTap() {
    basTrackCTA("install_balloon_tap");
    if (!basPrompt) return;
    basPrompt.prompt();
    basPrompt.userChoice.then((c) => {
        if (c.outcome === 'accepted') {
            stat.innerText = "INSTALLED";
            ball.className = "bas-ball is-pwa-installed";
            basTrackCTA("install_accepted");
        } else {
            basTrackCTA("install_dismissed");
        }
        basPrompt = null;
    });
}

