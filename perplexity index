function sendFinalDataToAnalytics() {
    if (typeof gtag === 'function') {
        gtag('event', 'total_donation_submit', {
            last_clicked_site: lastClickedSite,
            amount: parseFloat(pendingAmount),
            saved_time: pendingTime,
            page_location: location.href,
            page_path: location.pathname
        });
    }

    basTrackDonation(lastClickedSite, pendingAmount, "final_submit", { saved_time: pendingTime });

    let statusDiv = document.getElementById('save-status-msg');
    statusDiv.innerHTML = `<span class="status-msg">Reported ₹${pendingAmount} successfully! Thank you.</span>`;

    document.getElementById('donation-amount').value = "";

    setTimeout(() => {
