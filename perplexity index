        basTrackCTA("section8_read_more");
    }
}

function loadShops(shopsArray) {
    featuredShops.innerHTML = "";

    if (!shopsArray || shopsArray.length === 0) {
        featuredShops.innerHTML =
            "<div style='text-align:center;font-weight:bold;padding:20px;'>No shops available.</div>";
        basTrack("bas_no_shops", { event_category: "error" });
        return;
    }

    const colors = [
        "#00C853", "#2196F3", "#F44336", "#FF9800", "#9C27B0",
        "#00BCD4", "#E91E63", "#FFC107", "#009688", "#795548"
    ];

    shopsArray.slice(0, 10).forEach((shop, index) => {
        let host = "";
        try {
            host = new URL(shop.u).hostname;
        } catch (e) {}

        featuredShops.innerHTML += `
<a href="${shop.u}" target="_blank"
class="shopCard"
style="border-left-color:${colors[index % 10]}"
onclick="basTrackClick('shop_card_click', '${shop.u}', { outbound: true, shop_name: ${JSON.stringify(shop.n || '')} })">

<div class="shopDot">${(shop.a || "").trim() ? "" : "."}</div>

<img class="shopFav"
src="https://www.google.com/s2/favicons?domain=${host}&sz=64"
loading="lazy">

<div class="shopName notranslate" translate="no">
${shop.n}
</div>

</a>`;
    });

    basTrack("bas_shops_loaded", {
        event_category: "engagement",
        shops_count: Math.min(10, shopsArray.length)
    });
}

function fetchExternalCountryJS(countryName) {
    featuredShops.innerHTML =
        "<div style='text-align:center;padding:20px;color:#ff9800;font-weight:bold;'>Loading shops...</div>";

    const oldScript = document.getElementById("dynamic-country-script");
    if (oldScript) oldScript.remove();

    const script = document.createElement("script");
    script.id = "dynamic-country-script";
    script.src = "./" + countryName + ".js";

    script.onload = function () {
        loadedCountries[countryName] = true;

        if (window.countryShops && window.countryShops[countryName]) {
            loadShops(countryShops[countryName]);
            syncCategory(countryName);
            basTrack("bas_country_file_loaded", { country: countryName });
        } else {
            featuredShops.innerHTML =
                "<div style='text-align:center;padding:20px;color:red;'>No shop data</div>";
            basTrack("bas_country_no_data", { country: countryName });
        }
    };

    script.onerror = function () {
        featuredShops.innerHTML =
            "<div style='text-align:center;padding:20px;color:red;'>Country file not found</div>";
        basTrack("bas_country_file_error", { country: countryName });
    };

    document.body.appendChild(script);
}

