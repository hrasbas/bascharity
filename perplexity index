<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script> 

<script>
// വെബ്സൈറ്റ് മൊബൈലിലേക്ക് ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള പ്രോംപ്റ്റ് നിയന്ത്രിക്കുന്ന ലോജിക്
let deferredPrompt;
const installDiv = document.getElementById('install-div');
const installBtn = document.getElementById('install-btn'); 

window.addEventListener('beforeinstallprompt', (e) => {
e.preventDefault();
deferredPrompt = e;
if (installDiv) installDiv.style.display = 'block';
}); 

if (installBtn) {
installBtn.addEventListener('click', async () => {
try {
if (!deferredPrompt) return;
if (installDiv) installDiv.style.display = 'none';
const result = await deferredPrompt.prompt();
if (result && result.outcome === 'accepted') {
console.log('App Installed');
}
deferredPrompt = null;
} catch (err) {
deferredPrompt = null;
console.error('Install prompt error:', err);
}
});
} 

window.addEventListener('appinstalled', () => {
deferredPrompt = null;
if (installDiv) installDiv.style.display = 'none';
}); 

if ('serviceWorker' in navigator) {
window.addEventListener('load', () => {
navigator.serviceWorker.register('sw.js').catch((err) => {
console.error('SW registration failed:', err);
});
});
}
</script>      
