<script>
const allCountriesList=[
"afghanistan","albania","algeria","andorra","angola","argentina","armenia","australia","austria","bahrain","bangladesh","belgium","brazil","canada","china","colombia","denmark","egypt","finland","france","germany","ghana","greece","hong_kong","hungary","iceland","india","indonesia","iran","iraq","ireland","israel","italy","japan","jordan","kenya","kuwait","malaysia","maldives","mexico","morocco","nepal","netherlands","new_zealand","nigeria","norway","oman","pakistan","philippines","poland","portugal","qatar","romania","russia","saudi arabia","singapore","south_africa","south_korea","spain","sri_lanka","sudan","sweden","switzerland","thailand","turkey","uae","uk","usa","vietnam","yemen","zambia","zimbabwe"
];

const allCountries = document.getElementById("allCountries");
const featuredShops = document.getElementById("featuredShops");

window.countryShops = window.countryShops || {};
const loadedCountries = {};

allCountriesList.forEach(country => {
    const option = document.createElement("option");
    option.value = country;
    option.textContent = country.toUpperCase();
    allCountries.appendChild(option);
});

function setSelectedCountry(country) {
    if (!country) return;
    const pureCountry = country.trim().toLowerCase();
    allCountries.classList.add("green-select");

    document.querySelectorAll(".country-btn").forEach(btn => {
        const key = btn.getAttribute("data-country");
        btn.classList.toggle("active", key && key.trim().toLowerCase() === pureCountry);
    });

    const shopBtn = document.getElementById("shopOnCountry");
    if (shopBtn) {
        shopBtn.innerHTML = `SHOP ON <span class="green">${pureCountry.toUpperCase()}</span>`;
    }

    localStorage.setItem("selectedCountry", pureCountry);
    fetchExternalCountryJS(pureCountry);
}

function renderCountry(country) {
    setSelectedCountry(country);
}

function syncCategory(countryName) {
    if (typeof changeCountry === "function") {
        changeCountry(countryName);
    }
}

function fetchExternalCountryJS(countryName) {
    if (loadedCountries[countryName]) {
        loadShops(countryShops[countryName]);
        syncCategory(countryName);
        return;
    }

    if (window.countryShops && window.countryShops[countryName]) {
        loadedCountries[countryName] = true;
        loadShops(countryShops[countryName]);
        syncCategory(countryName);
        return;
    }

    featuredShops.innerHTML = "<div style='text-align:center;padding:20px;color:#ff9800;font-weight:bold;'>Loading shops...</div>";

    const oldScript = document.getElementById("dynamic-country-script");
    if (oldScript) oldScript.remove();

    const script = document.createElement("script");
    script.id = "dynamic-country-script";
    script.src = "./" + countryName + ".js";
    script.onload = function () {
        loadedCountries[countryName] = true;
        if (window.countryShops && window.countryShops[countryName]) {
            loadShops(countryShops[countryName]);
            syncCategory(countryName);
        } else {
            featuredShops.innerHTML = "<div style='text-align:center;padding:20px;color:red;'>No shop data</div>";
        }
    };

    script.onerror = function () {
        featuredShops.innerHTML = "<div style='text-align:center;padding:20px;color:red;'>Country file not found</div>";
    };

    document.body.appendChild(script);
}

function loadShops(shopsArray) {
    featuredShops.innerHTML = "";
    if (!shopsArray || shopsArray.length === 0) {
        featuredShops.innerHTML = "<div style='text-align:center;font-weight:bold;padding:20px;'>No shops available.</div>";
        return;
    }

    const colors = ["#00C853", "#2196F3", "#F44336", "#FF9800", "#9C27B0", "#00BCD4", "#E91E63", "#FFC107", "#009688", "#795548"];

    shopsArray.slice(0, 10).forEach((shop, index) => {
        let host = "";
        try { host = new URL(shop.u).hostname; } catch (e) { }

        featuredShops.innerHTML += `
<a href="${shop.u}" target="_blank" class="shopCard" style="border-left-color:${colors[index % 10]}">
<div class="shopDot">${(shop.a || "").trim() ? "" : "."}</div>
<img class="shopFav" src="https://www.google.com/s2/favicons?domain=${host}&sz=64" loading="lazy">
<div class="shopName notranslate" translate="no">${shop.n}</div>
</a>`;
    });
}

document.addEventListener("DOMContentLoaded", () => {
    const savedCountry = localStorage.getItem("selectedCountry") || "india";
    setSelectedCountry(savedCountry);

    document.querySelectorAll(".country-btn").forEach(btn => {
        btn.addEventListener("click", function () {
            const key = this.getAttribute("data-country") || this.textContent;
            setSelectedCountry(key.trim().toLowerCase());
        });
    });

    allCountries.addEventListener("change", e => {
        if (e.target.value) {
            setSelectedCountry(e.target.value);
            allCountries.selectedIndex = 0;
        }
    });
});
</script>

