<script>
(function () {

const map = {
en:"english", ml:"malayalam", hi:"hindi", ar:"arabic", ta:"tamil", ur:"urdu", es:"spanish", pt:"portuguese"
};

window.updateDedication = function(langCode){
    const key = map[langCode] || "english";
    if(
        window.dedicationData &&
        window.dedicationData[key] &&
        document.getElementById("dedication-text")
    ){
        document.getElementById("dedication-text").innerHTML =
        window.dedicationData[key].content;
    }
};

const oldChangeLang = window.changeLang;
window.changeLang = function(langCode){
    if(typeof oldChangeLang === "function"){
        oldChangeLang(langCode);
    }
    setTimeout(function(){
        updateDedication(langCode);
    },800);
};

const oldReset = window.resetToEnglish;
window.resetToEnglish = function(){
    if(typeof oldReset === "function"){
        oldReset();
    }
    setTimeout(function(){
        updateDedication("en");
    },800);
};

document.addEventListener("DOMContentLoaded",function(){
    updateDedication("en");
    const timer = setInterval(function(){
        const s = document.querySelector(".goog-te-combo");
        if(s){
            s.addEventListener("change",function(){
                setTimeout(function(){
                    updateDedication(s.value);
                },800);
            },{once:false});
            clearInterval(timer);
        }
    },300);
});

})(); 
</script>

