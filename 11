/* പ്രധാന ബോക്സുകൾ വലിയ സ്ക്രീനുകളിൽ 900px ലേക്ക് ഒതുക്കി നിർത്താനും ഫോണിൽ റെസ്പോൺസിവ് ആക്കാനുമുള്ള ഘടന */
.bas-dedication, .lang-box, .country-box, .shop-container, .compare-container, .share-container, .mainbox, .info-box, .bas7-wrapper, .trust-container, .peace-wrapper, .vada-wrapper, .vision-wrapper, #bas-mega-portal {
