<button id="install-btn" type="button">Install App</button>
</div> 

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script> 

<script>
// വെബ്സൈറ്റ് മൊബൈലിലേക്ക് ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള പ്രോംപ്റ്റ് നിയന്ത്രിക്കുന്ന ലോജിക്
let deferredPrompt;
const installDiv = document.getElementById('install-div');
const installBtn = document.getElementById('install-btn'); 

window.addEventListener('beforeinstallprompt', (e) => {
e.preventDefault();
deferredPrompt = e;
if (installDiv) installDiv.style.display = 'block';
}); 

if (installBtn) {
installBtn.addEventListener('click', async () => {
try {
if (!deferredPrompt) return;
if (installDiv) installDiv.style.display = 'none';
const result = await deferredPrompt.prompt();
if (result && result.outcome === 'accepted') {
console.log('App Installed');
}
deferredPrompt = null;
} catch (err) {
deferredPrompt = null;
console.error('Install prompt error:', err);
}
});
} 

window.addEventListener('appinstalled', () => {
deferredPrompt = null;
if (installDiv) installDiv.style.display = 'none';
}); 

// ബാക്ക്ഗ്രൗണ്ടിൽ ഓഫ്‌ലൈൻ സപ്പോർട്ടിനായി സർവീസ് വർക്കർ രജിസ്റ്റർ ചെയ്യുന്നു
if ('serviceWorker' in navigator) {
window.addEventListener('load', () => {
navigator.serviceWorker.register('sw.js').catch((err) => {
console.error('SW registration failed:', err);
});
});
} 

// 3D ഭൂമിയും (Earth) അതിനു ചുറ്റും കറങ്ങുന്ന ചന്ദ്രനും (Moon) നിർമ്മിക്കുന്നതിനുള്ള ത്രീ-ജെഎസ് കോഡ്
let scene, camera, renderer, ambient, loader, earthGroup, earth, moon, angle = 0, running = true, logoSpace, animateRef = null; 

try {
if (window.THREE) {
logoSpace = document.getElementById('logo-space'); 

scene = new THREE.Scene();
camera = new THREE.PerspectiveCamera(50, window.innerWidth / 340, 0.1, 1000);
renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: "high-performance" });
renderer.setSize(window.innerWidth, 340);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); 

if (logoSpace) {
logoSpace.appendChild(renderer.domElement);
} 

ambient = new THREE.AmbientLight(0xffffff, 1.2);
scene.add(ambient); 

loader = new THREE.TextureLoader();
earthGroup = new THREE.Group(); 

// ഗ്ലോബിലേക്ക് ഭൂമിയുടെ സാറ്റലൈറ്റ് മാപ്പ് ടെക്സ്ചർ ലോഡ് ചെയ്യുന്നു
earth = new THREE.Mesh(
new THREE.SphereGeometry(2, 32, 32),
new THREE.MeshStandardMaterial({
map: loader.load(
'https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/earth_atmos_2048.jpg',
undefined,
undefined,
function () { console.error('Earth texture failed to load'); }
),
metalness: 0.2,
roughness: 0.8
})
);
earthGroup.add(earth); 

// ഭൂമിക്ക് മുകളിലായി കറങ്ങുന്ന രീതിയിൽ BAS എന്ന അക്ഷരങ്ങൾ ക്യാൻവാസ് വഴി വരച്ച് ചേർക്കുന്നു
let canvas = document.createElement('canvas');
let ctx = canvas.getContext('2d');
if (ctx) {
canvas.width = 1024;
canvas.height = 256;
ctx.fillStyle = "#FFFFFF";
ctx.font = "Bold 140px Arial";
ctx.textAlign = "center";
ctx.fillText("BAS", 256, 160);
ctx.fillText("BAS", 768, 160); 

let textTexture = new THREE.CanvasTexture(canvas);
let textMesh = new THREE.Mesh(
new THREE.CylinderGeometry(2.05, 2.05, 0.8, 64, 1, true),
new THREE.MeshBasicMaterial({ map: textTexture, transparent: true, side: THREE.DoubleSide })
);
earthGroup.add(textMesh);
} 

scene.add(earthGroup); 

// ഭൂമിക്ക് പുറത്ത് കറങ്ങുന്ന ചെറിയ ചന്ദ്രനെ (Moon Sphere) ഉണ്ടാക്കുന്നു
moon = new THREE.Mesh(
new THREE.SphereGeometry(0.35, 16, 16),
new THREE.MeshStandardMaterial({ color: 0xcccccc })
);
scene.add(moon); 

camera.position.z = 8; 

// ഫോൺ തിരിക്കുമ്പോഴും സ്ക്രീൻ സൈസ് മാറുമ്പോഴും 3D ഗ്ലോബ് തകരാതെ കൃത്യമായി ക്രമീകരിക്കുന്നു
function resizeRenderer() {
try {
const box = document.getElementById("logo-space");
if (!box || !renderer || !camera) return;
const width = box.clientWidth || window.innerWidth;
renderer.setSize(width, 340);
camera.aspect = width / 340;
camera.updateProjectionMatrix();
} catch (e) {
console.error('Resize error:', e);
}
} 

window.addEventListener("resize", resizeRenderer); 

// ನಿರ್ಥಾದೆ 3D ഗ്ലോബും ചന്ദ്രനും ആനിമേറ്റ് ചെയ്ത് കറക്കാനുള്ള ലൂപ്പ് ഫംഗ്ഷൻ
function animate() {
if (!running || !renderer || !scene || !camera || !earthGroup || !moon) return;
animateRef = requestAnimationFrame(animate);
earthGroup.rotation.y += 0.003;
angle -= 0.01;
moon.position.x = Math.cos(angle) * 4.5;
moon.position.z = Math.sin(angle) * 2.8;
renderer.render(scene, camera);
}
animate(); 

// യൂസർ സ്ക്രീൻ സ്ക്രോൾ ചെയ്ത് ലോഗോ കാണുമ്പോൾ മാത്രം 3D റൺ ചെയ്യിച്ച് ബാറ്ററി ലാഭിക്കാനുള്ള ലോജിക്
if ('IntersectionObserver' in window && logoSpace) {
let observer = new IntersectionObserver(entries => {
entries.forEach(entry => {
if (entry.isIntersecting) {
const wasStopped = !running;
running = true;
if (wasStopped) animate();
} else {
running = false;
}
});
});
observer.observe(logoSpace);
} 

// സിസ്റ്റം ലോഡ് കാരണം WebGL ക്രാഷായാൽ അത് കണ്ടെത്തി റീസ്റ്റാർട്ട് ചെയ്യാനുള്ള സുരക്ഷാ കോഡ്
if (renderer && renderer.domElement) {
renderer.domElement.addEventListener('webglcontextlost', function (event) {
event.preventDefault();
running = false;
console.error('WebGL context lost');
}, false); 

renderer.domElement.addEventListener('webglcontextrestored', function () {
running = true;
animate();
}, false);
}
}
} catch (e) {
console.error('Three.js init error:', e);
} 

// ഗൂഗിൾ ട്രാൻസ്ലേഷൻ എലമെന്റ് സൈറ്റിലേക്ക് ഇനിഷ്യലൈസ് ചെയ്യുന്ന ഫംഗ്ഷൻ
function googleTranslateElementInit() {
try {
if (window.google && google.translate && google.translate.TranslateElement) {
new google.translate.TranslateElement({ pageLanguage: 'en', autoDisplay: false }, 'google_translate_element');
}
} catch (e) {
console.error('Google Translate init error:', e);
}
} 

// ബട്ടണുകളിൽ ക്ലിക്ക് ചെയ്യുമ്പോൾ ഓരോ പ്രത്യേക ഭാഷകളിലേക്ക് സൈറ്റ് മാറ്റാനുള്ള ലോജിക്
function changeLang(langCode) {
try {
