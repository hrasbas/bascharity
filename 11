.state-hide { transform: translateY(120%) !important; }
.state-rest { transform: translateY(70%) !important; } 

/* ബലൂണിന്റെ റൗണ്ട് ഷേപ്പും ഉള്ളിലെ നൂലും നിപ്പിളും ഉണ്ടാക്കാനുള്ള CSS */
.bas-ball {
position: absolute;
border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
cursor: pointer;
pointer-events: auto;
box-shadow: inset -8px -8px 20px rgba(0,0,0,0.4);
} 

.bas-str {
position: absolute;
width: 1px;
background: rgba(255,255,255,0.4);
bottom: -1000px;
left: 50%;
height: 1000px;
} 

.bas-nipple {
position: absolute;
bottom: -10px;
width: 18px;
height: 10px;
background: inherit;
clip-path: polygon(20% 0, 80% 0, 100% 100%, 0 100%);
} 

/* വെള്ള, നീല ബലൂണുകളുടെ വലിപ്പവും അവ ഫ്ലോട്ട് ചെയ്യാനുള്ള ആനിമേഷൻ ലിങ്കും */
.white-b {
width: 120px; height: 160px;
background: #ffffff;
bottom: 220px; left: 60px;
animation: floatW 25s ease-in-out infinite;
transition: background 0.4s ease;
} 

.blue-b {
width: 105px; height: 135px;
background: #007bff;
bottom: 70px; left: 30px;
animation: floatB 20s ease-in-out infinite;
} 

.bas-sticker { width: 75px; height: 75px; border-radius: 20px; margin-bottom: 5px; border: 1px solid #ddd; }
.bas-lbl { font-family: sans-serif; font-size: 11px; font-weight: 900; text-align: center; line-height: 1.2; } 

/* ആപ്പ് ഇൻസ്റ്റാൾ ചെയ്യാൻ റെഡി ആകുമ്പോഴും ഇൻസ്റ്റാൾഡ് ആകുമ്പോഴും മാറേണ്ട കളർ കോഡുകൾ */
.install-ready {
